{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "enabledManagers": [
    "dockerfile"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/^Containerfile\\.cli$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "quay.io/light-factory/python-builder"
      ],
      "enabled": true,
      "pinDigests": true,
      "automerge": false,
      "allowedVersions": "/^latest$/"
    }
  ]
}
